{
  "name": "keepsake",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A privacy-first hybrid AI assistant: strictly on-device inference in Vault Mode, consent-gated cloud inference in Hybrid Mode, through Firebase AI Logic.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  }
}
