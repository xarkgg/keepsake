{
  "name": "Keepsake",
  "short_name": "Keepsake",
  "description": "A privacy-first AI assistant. Vault Mode runs entirely on your device; Hybrid Mode sends only what you approve to the cloud.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["cover-display-cutout", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/apple-touch-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
