# --- Data ---
# Postgres for production. Unset means embedded PGlite (real Postgres) for dev.
# Vercel Postgres / Neon: copy the connection string from the Marketplace. The
# Neon/Vercel integration injects DATABASE_URL (and POSTGRES_URL); Keepsake
# reads any of those, so setting KEEPSAKE_DATABASE_URL by hand is optional. A
# serverless host with none of them refuses to serve rather than run on an
# ephemeral, per-instance database.
KEEPSAKE_DATABASE_URL=
# KEEPSAKE_PGLITE_DIR=./data/pglite

# --- Server ---
PORT=8787
HOST=0.0.0.0
# The exact public origin. Used for origin checks.
KEEPSAKE_PUBLIC_URL=https://keepsake.example.com
# KEEPSAKE_DATA_DIR=./data
# KEEPSAKE_SESSION_DAYS=30
# KEEPSAKE_COOKIE_SECURE=auto
# KEEPSAKE_TRUST_PROXY=1
# KEEPSAKE_SIGNUPS=open
# Comma-separated addresses of shared demo accounts. Password changes and
# account deletion are disabled for these addresses.
# KEEPSAKE_DEMO_ACCOUNTS=

# --- Firebase ---
# One project backs both Firebase Authentication (sign-in) and Firebase AI Logic
# (the only cloud inference path). Set the project id to turn sign-in on; the
# app returns the web config to the client and the server verifies the
# resulting ID token against Google's public keys, so no service-account secret
# is needed. Values are from Firebase console -> Project settings -> General ->
# Your apps -> Web app -> SDK setup. They are public by design (the web client
# ships them).
#
# Firebase AI Logic and App Check are enabled in the console, not here: the
# client SDK (and App Check's reCAPTCHA Enterprise provider) read the same
# public web config at runtime. Both inference modes need the Firebase web config.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key for App Check. Cloud inference requires
# it. On-device generation does not use App Check.
FIREBASE_APPCHECK_SITE_KEY=
# Set to 0 to keep Keepsake's own password login even when Firebase is configured.
# FIREBASE_AUTH_ENABLED=1
